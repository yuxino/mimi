{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for mimi windows (settings, overlay, tray panel, language popover).",
  "windows": ["settings", "overlay", "tray-panel", "language-popover"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-hide"
  ]
}
