{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "The settings window may manage preferences and profiles, inspect the running version, and use the fixed release actions.",
  "windows": ["settings"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-emit",
    "process:allow-restart",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "app-settings"
  ]
}
